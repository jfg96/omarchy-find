#!/usr/bin/env python3
"""Candidate collector for Omarchy Find.

Runs concurrent fd passes over $HOME (filename, full path and a fuzzy
fallback) and merges them in relevance order. fd walks a typical home in tens
of milliseconds, never returns stale paths, prunes excluded directories while
walking and never follows symlinks. Matching is accent-insensitive.
"""

from __future__ import annotations

import argparse
import os
import signal
import subprocess
import sys
import unicodedata


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--home", required=True)
    parser.add_argument("--query", required=True)
    parser.add_argument("--kind", choices=("d", "f"), required=True)
    parser.add_argument("--max-results", type=int, default=2000)
    parser.add_argument("--extensions", default="")
    parser.add_argument("--exclude", action="append", default=[])
    parser.add_argument("--hidden", action="store_true")
    parser.add_argument("--system-folders", action="store_true")
    return parser.parse_args()


ACCENT_CLASSES = {
    "a": "[aáàãâä]",
    "e": "[eéèêë]",
    "i": "[iíìîï]",
    "o": "[oóòõôö]",
    "u": "[uúùûü]",
    "c": "[cç]",
    "n": "[nñ]",
}
REGEX_SPECIALS = "\\^$.[]|()?*+{}"


def regex_escape(text: str) -> str:
    return "".join("\\" + char if char in REGEX_SPECIALS else char for char in text)


def accent_char(char: str) -> str:
    base = unicodedata.normalize("NFD", char.lower())[0]
    return ACCENT_CLASSES.get(base) or regex_escape(char)


def accent_pattern(term: str) -> str:
    """Accent-insensitive literal: "cancion" also matches "Canción"."""
    return "".join(accent_char(char) for char in term)


def fuzzy_pattern(term: str) -> str:
    """Ordered subsequence: "omfind" matches "omarchy-find"."""
    return ".*".join(accent_char(char) for char in term)


class Collector:
    def __init__(self, args: argparse.Namespace) -> None:
        self.args = args
        self.home = os.path.realpath(args.home)
        self.extensions = sorted(
            {ext.lower().lstrip(".") for ext in args.extensions.split(",") if ext}
        )
        self.results: list[str] = []
        self.seen: set[str] = set()
        self.processes: list[subprocess.Popen[bytes]] = []
        self.cancelled = False

    def cancel(self) -> None:
        """Stop candidate collection and every running child process."""
        self.cancelled = True
        for proc in list(self.processes):
            self.stop(proc)

    def add(self, path: str) -> bool:
        path = os.path.normpath(path)
        if path not in self.seen:
            self.seen.add(path)
            self.results.append(path)
        return len(self.results) >= self.args.max_results

    def spawn_fd(self, terms: list[str], mode: str) -> subprocess.Popen[bytes] | None:
        """Start an fd pass now; its output waits in the pipe until consumed.

        Passes are spawned together so their walks overlap, while consuming
        them in order keeps the candidate ranking deterministic.
        """
        if self.cancelled:
            return None
        binary = os.environ.get("OMARCHY_FIND_FD", "fd")
        argv = [
            binary, "-0", "--color=never", "-i", "--no-ignore",
            "--max-results", str(self.args.max_results),
            "--type", self.args.kind,
        ]
        if self.args.hidden:
            argv.append("--hidden")
        for pattern in self.args.exclude:
            argv.extend(("-E", pattern))
        if self.args.system_folders:
            argv.extend(("--max-depth", "3"))
        if self.args.kind == "f":
            for extension in self.extensions:
                argv.extend(("-e", extension))

        if mode == "path":
            # Anchor below $HOME so a term that occurs in the home path itself
            # (e.g. the user name) does not match every file.
            home = regex_escape(self.home)
            patterns = [f"^{home}/.*" + accent_pattern(term) for term in terms]
            argv.append("--full-path")
        elif mode == "fuzzy":
            patterns = [fuzzy_pattern(term) for term in terms]
        else:
            patterns = [accent_pattern(term) for term in terms]
        for pattern in patterns[1:]:
            argv.extend(("--and", pattern))
        argv.extend(("--", patterns[0]))

        if self.args.system_folders:
            argv.extend((os.path.join(self.home, ".config"), os.path.join(self.home, ".local", "share")))
        else:
            argv.append(self.home)
        try:
            proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            return None
        self.processes.append(proc)
        return proc

    def stop(self, proc: subprocess.Popen[bytes]) -> None:
        if proc.poll() is None:
            proc.terminate()
        try:
            proc.wait(timeout=0.2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        if proc in self.processes:
            self.processes.remove(proc)

    def consume(self, proc: subprocess.Popen[bytes] | None) -> None:
        if proc is None:
            return
        try:
            if self.cancelled or len(self.results) >= self.args.max_results:
                return
            assert proc.stdout is not None
            buffer = b""
            while True:
                # BufferedReader.read(size) may wait for the entire requested
                # chunk while the producer is still alive. read1() performs at
                # most one pipe read, so a complete early record can stop a
                # noisy fd process as soon as the result cap is met.
                chunk = proc.stdout.read1(4096)
                if not chunk:
                    break
                buffer += chunk
                records = buffer.split(b"\0")
                buffer = records.pop()
                for record in records:
                    if record and self.add(os.fsdecode(record)):
                        return
            if buffer:
                self.add(os.fsdecode(buffer))
        finally:
            self.stop(proc)

    def finish(self) -> None:
        """Stop passes that were spawned but not needed after the cap."""
        for proc in list(self.processes):
            self.stop(proc)


def main() -> int:
    args = parse_args()
    terms = list(dict.fromkeys(args.query.split()))
    if not terms or args.max_results <= 0:
        return 0

    collector = Collector(args)

    # Quickshell cancels obsolete searches by terminating this helper. Relay
    # that cancellation to fd so rapid query or category changes never leave
    # an orphan collector holding the stdout pipe open.
    def handle_signal(signum: int, _frame: object) -> None:
        collector.cancel()
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    # Filename matches first, then path matches. This avoids a matching parent
    # directory filling the candidate budget with every descendant. A term
    # containing "/" can only match a full path, so it skips the filename pass.
    basename = None
    if not any("/" in term for term in terms):
        basename = collector.spawn_fd(terms, "basename")
    full_path = collector.spawn_fd(terms, "path")
    collector.consume(basename)
    collector.consume(full_path)

    # Fuzzy matching is a last resort, never the primary candidate source.
    if (
        len(collector.results) < min(60, args.max_results)
        and all(len(term) >= 3 and "/" not in term for term in terms)
    ):
        collector.consume(collector.spawn_fd(terms, "fuzzy"))

    collector.finish()
    sys.stdout.write("".join(path + "\n" for path in collector.results))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
