#!/bin/bash

# Toggle file search overlay. Thin wrapper over omarchy-shell IPC.

set -euo pipefail

PLUGIN_ID="oma.find"
# Resolved through the ~/.local/bin link install-cli makes, to the plugin.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

BINDINGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
# The shortcut lives between these markers, so it can be replaced or removed
# without touching anything else in bindings.lua.
KEYBIND_BEGIN="-- >>> oma.find shortcut (managed by omarchy-find, edits are replaced)"
KEYBIND_END="-- <<< oma.find shortcut"

# Prints bindings.lua without the managed block, nor the two lines earlier
# versions appended: their comment and their o.bind, matched exactly. Fails
# on a begin marker with no end, which would otherwise drop the rest of the file.
strip_bindings() {
  awk -v begin="$KEYBIND_BEGIN" -v end="$KEYBIND_END" '
    $0 == begin { inside = 1; next }
    inside && $0 == end { inside = 0; next }
    inside { next }
    $0 == "-- Omarchy Find file search overlay" { next }
    /^o\.bind\("[A-Za-z0-9 _+]+", "Find files & folders", "(omarchy-find|omarchy-shell shell toggle (oma\.find|jesseburlamaque\.omarchy-find))"\)$/ { next }
    { print }
    END { if (inside) exit 3 }
  ' "$1"
}

# Rewrites bindings.lua without our shortcut, then appends $1 when given.
# Writes through a symlink to its target, keeps a backup of the file as it was
# before the first change, and replaces it in one rename. Returns 1 when the
# file would come out the same, and then writes nothing.
write_bindings() {
  local block="$1" target tmp kept status=0
  target=$(realpath -- "$BINDINGS_FILE")
  tmp=$(mktemp "$target.XXXXXX")
  strip_bindings "$target" > "$tmp" || status=$?
  if (( status != 0 )); then
    rm -f -- "$tmp"
    echo "omarchy-find: $BINDINGS_FILE has '$KEYBIND_BEGIN' without '$KEYBIND_END'; fix it by hand." >&2
    exit 1
  fi
  if [ -z "$block" ] && cmp -s -- "$tmp" "$target"; then
    rm -f -- "$tmp"
    return 1
  fi
  # $(...) drops trailing newlines, so the blank lines left where the shortcut
  # was do not pile up at the end of the file.
  kept=$(cat -- "$tmp")
  {
    [ -z "$kept" ] || printf '%s\n' "$kept"
    if [ -n "$block" ]; then
      [ -z "$kept" ] || printf '\n'
      printf '%s\n' "$block"
    fi
  } > "$tmp"
  if cmp -s -- "$tmp" "$target"; then
    rm -f -- "$tmp"
    return 1
  fi
  [ -e "$target.omarchy-find.bak" ] || cp -p -- "$target" "$target.omarchy-find.bak"
  chmod --reference="$target" -- "$tmp"
  mv -- "$tmp" "$target"
}

reload_hyprland() {
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
    echo "✓ Hyprland configuration reloaded."
  fi
}

install_cli_and_desktop() {
  mkdir -p "$HOME/.local/bin"
  # A link, not a copy, so the command follows the plugin's updates. It
  # replaces the copy earlier versions installed.
  if [ -f "$SCRIPT_DIR/omarchy-find" ]; then
    ln -sfn -- "$SCRIPT_DIR/omarchy-find" "$HOME/.local/bin/omarchy-find"
  fi

  if [ -f "$ROOT_DIR/share/omarchy-find.desktop" ]; then
    mkdir -p "$HOME/.local/share/applications"
    install -m 644 "$ROOT_DIR/share/omarchy-find.desktop" "$HOME/.local/share/applications/omarchy-find.desktop"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" || true
  fi
}

verb="${1:-toggle}"
payload="${2:-}"
[ -z "$payload" ] && payload='{}'

case "$verb" in
  toggle)
    exec omarchy-shell shell toggle "$PLUGIN_ID" "$payload"
    ;;
  open | summon)
    exec omarchy-shell shell summon "$PLUGIN_ID" "$payload"
    ;;
  close | hide)
    exec omarchy-shell shell hide "$PLUGIN_ID"
    ;;
  install-cli)
    install_cli_and_desktop
    echo "✓ omarchy-find linked at $HOME/.local/bin/omarchy-find"
    echo "✓ Launcher entry installed at $HOME/.local/share/applications/omarchy-find.desktop"
    ;;
  setup-keybind | install-keybind)
    install_cli_and_desktop
    KEYBIND="${payload:-ALT + SPACE}"
    [ "$KEYBIND" = "{}" ] && KEYBIND="ALT + SPACE"
    if ! echo "$KEYBIND" | grep -qE '^[A-Za-z0-9 _+]+$'; then
      echo "omarchy-find: invalid keybind '$KEYBIND'. Use a form like 'ALT + SPACE' or 'SUPER + F'." >&2
      exit 1
    fi

    mkdir -p "$(dirname "$BINDINGS_FILE")"
    if [ ! -e "$BINDINGS_FILE" ]; then
      if [ -f "/usr/share/omarchy/config/hypr/bindings.lua" ]; then
        cp "/usr/share/omarchy/config/hypr/bindings.lua" "$BINDINGS_FILE"
      else
        cat <<'EOF' > "$BINDINGS_FILE"
-- Keep only your personal keybinding overrides here.
EOF
      fi
    fi

    block="$KEYBIND_BEGIN
o.bind(\"$KEYBIND\", \"Find files & folders\", \"omarchy-shell shell toggle $PLUGIN_ID\")
$KEYBIND_END"
    write_bindings "$block" || true
    echo "✓ omarchy-find linked at $HOME/.local/bin/omarchy-find"
    echo "✓ Global shortcut '$KEYBIND' set in $BINDINGS_FILE"
    reload_hyprland
    ;;
  remove-keybind | uninstall-keybind)
    if [ ! -e "$BINDINGS_FILE" ]; then
      echo "No $BINDINGS_FILE found."
      exit 0
    fi
    if write_bindings ""; then
      echo "✓ Omarchy Find shortcut removed from $BINDINGS_FILE"
      reload_hyprland
    else
      echo "No Omarchy Find shortcut in $BINDINGS_FILE."
    fi
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: omarchy-find [command] [argument]

Commands:
  toggle [payload]            Open Find, or close if already open (default).
  open|summon [payload]       Always open. Optional payload: '{"query":"term"}'
  close|hide                  Close the search overlay.
  setup-keybind [shortcut]    Configure global shortcut in Hyprland (default: "ALT + SPACE").
  remove-keybind              Remove global shortcut from Hyprland bindings.
  install-cli                 Install omarchy-find to ~/.local/bin and .desktop launcher.

Examples:
  omarchy-find
  omarchy-find open '{"query":"notes"}'
  omarchy-find setup-keybind
  omarchy-find setup-keybind "SUPER + F"
  omarchy-find remove-keybind
USAGE
    ;;
  *)
    echo "omarchy-find: unknown command '$verb'. Try 'omarchy-find --help'." >&2
    exit 2
    ;;
esac
